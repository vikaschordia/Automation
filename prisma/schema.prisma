// Daily Task Tracker — Prisma schema (MongoDB Atlas)
//
// Enums are represented as plain String fields (not Prisma `enum` blocks) because the app
// originally targeted SQLite, which has no native enum type; keeping String here too means no
// data-shape change was needed when switching to MongoDB. The allowed values for each are defined
// once in src/lib/constants.ts (TS union types + Zod enums) and validated at the API boundary.
//
// MongoDB's Prisma connector has no autoincrement Int ids — every model's `id` is a
// `String @id @default(auto()) @map("_id") @db.ObjectId`. Task used to derive its human-readable
// Task Number directly from an autoincrement id (`TSK-` + id.toString().padStart(6, "0")); since
// an ObjectId can't be formatted that way, Task now has a separate `taskNumber` Int, assigned
// sequentially via the Counter model (see nextTaskNumber in src/lib/services/task-service.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String
  role         String // ADMIN | EMPLOYEE
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employeeId String?   @unique @db.ObjectId
  employee   Employee? @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assignedTasks Task[]        @relation("AssignedBy")
  taskHistory   TaskHistory[]
  notes         Note[]

  @@index([role])
}

// Personal scratch-pad notes for the floating Notes widget — always scoped to the owning user,
// never shared or admin-visible, regardless of role. Deliberately has no relation to Task/Employee;
// it's a personal to-do list, not part of task tracking.
model Note {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  content   String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments           Department[]
  employees             Employee[]       @relation("EmployeePrimaryCompany")
  // Employees mapped here in addition to their primary company (see Employee.additionalCompanies).
  additionalEmployees   Employee[]       @relation("EmployeeAdditionalCompanies", fields: [additionalEmployeeIds], references: [id])
  additionalEmployeeIds String[]         @db.ObjectId
  tasks                 Task[]
  monthlyExpenses       MonthlyExpense[]
  unbilledEntries       UnbilledEntry[]
}

model Department {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  companyId String   @db.ObjectId
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  tasks     Task[]

  @@unique([name, companyId])
  @@index([companyId])
}

model Employee {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeCode String   @unique
  name         String
  designation  String
  email        String   @unique
  phone        String?
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  joiningDate  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departmentId String     @db.ObjectId
  department   Department @relation(fields: [departmentId], references: [id])
  companyId    String     @db.ObjectId
  company      Company    @relation("EmployeePrimaryCompany", fields: [companyId], references: [id])

  // Companies this employee is also mapped to, beyond their primary company/department above —
  // e.g. so they show up as assignable when a task is created under one of these companies.
  additionalCompanies  Company[] @relation("EmployeeAdditionalCompanies", fields: [additionalCompanyIds], references: [id])
  additionalCompanyIds String[]  @db.ObjectId

  managerId String?    @db.ObjectId
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports   Employee[] @relation("EmployeeManager")

  // Per-employee opt-in to the (otherwise admin-only) Monthly Expenses tab — full access (add,
  // edit, mark paid, delete), toggled from the employee create/edit form. Defaults off.
  canViewExpenses Boolean @default(false)

  // Same pattern as canViewExpenses above, but for the Monthly Unbilled Entries tab — independent
  // toggle, an employee can have either, both, or neither.
  canViewUnbilledEntries Boolean @default(false)

  user          User?  @relation("UserEmployee")
  assignedTasks Task[] @relation("AssignedTo")

  @@index([departmentId])
  @@index([companyId])
  @@index([managerId])
}

model TaskCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())

  tasks Task[]
}

// Atomic sequence generator — MongoDB has no native autoincrement, so a task's human-readable
// number is handed out by findOneAndUpdate($inc) against a single row keyed by `name` (see
// nextTaskNumber in src/lib/services/task-service.ts).
model Counter {
  id    String @id @map("_id")
  value Int    @default(0)
}

model Task {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  // Sequential, human-readable number assigned once at creation (see Counter model above);
  // formatted for display as `TSK-` + zero-padded string by formatTaskNumber(). Never reused or
  // renumbered, so it stays a stable, sortable proxy for creation order even though Task.id itself
  // is now an ObjectId.
  taskNumber  Int     @unique
  title       String
  description String?
  priority    String // P1_URGENT | P2_MEDIUM | P3_LOW
  status      String  @default("PENDING") // PENDING | IN_PROGRESS | WAITING_APPROVAL | COMPLETED | DELAYED | CANCELLED | ON_HOLD

  assignedDate  DateTime  @default(now())
  dueDate       DateTime
  completedDate DateTime?

  progressPercent Int     @default(0)
  estimatedHours  Float?
  actualHours     Float?
  remarks         String?
  tags            String  @default("[]") // JSON-encoded string[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Shared by every linked copy created when a task is assigned to multiple employees at once —
  // each employee gets their own independent Task row (own id/status/progress/etc.), correlated
  // only by this key. Null for an ordinary single-employee task (the vast majority). Never used
  // as a real relation/FK — it's purely a lookup key for "find this task's sibling assignments".
  groupId String?

  assignedToId String        @db.ObjectId
  assignedTo   Employee      @relation("AssignedTo", fields: [assignedToId], references: [id], onUpdate: NoAction)
  assignedById String        @db.ObjectId
  assignedBy   User          @relation("AssignedBy", fields: [assignedById], references: [id], onUpdate: NoAction)
  departmentId String        @db.ObjectId
  department   Department    @relation(fields: [departmentId], references: [id])
  companyId    String        @db.ObjectId
  company      Company       @relation(fields: [companyId], references: [id])
  categoryId   String?       @db.ObjectId
  category     TaskCategory? @relation(fields: [categoryId], references: [id])

  history TaskHistory[]

  @@index([assignedToId, status])
  @@index([companyId])
  @@index([departmentId])
  @@index([dueDate])
  @@index([priority])
  @@index([status])
  @@index([deletedAt])
  @@index([groupId])
}

// Fixed monthly expenses (rent, subscriptions, etc.) — entirely separate from task tracking,
// keyed off dueDate rather than a foreign key back to Task/Employee/Company. A recurring
// expense's future months aren't stored ahead of time; they're generated on demand (see
// ensureRecurringExpenses in expense-service.ts) the first time that later month is viewed,
// correlated to earlier months of the same series only by recurringGroupId (same non-FK
// correlation-key pattern as Task.groupId above).
model MonthlyExpense {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  dueDate          DateTime
  amount           Float
  status           String    @default("UNPAID") // UNPAID | PAID
  paidDate         DateTime?
  isRecurring      Boolean   @default(false)
  recurringGroupId String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  @@index([dueDate])
  @@index([recurringGroupId])
  @@index([companyId])
}

model TaskHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId      String   @db.ObjectId
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedById String   @db.ObjectId
  changedBy   User     @relation(fields: [changedById], references: [id], onUpdate: NoAction)
  action      String // CREATED | UPDATED | STATUS_CHANGED | COMPLETED | REOPENED
  field       String?
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([createdAt])
}

// Same shape and same on-demand recurring-month generation as MonthlyExpense above (see
// ensureRecurringUnbilledEntries in unbilled-entry-service.ts) — a separate tab for entries that
// are expected but not yet billed, rather than fixed outgoing expenses.
model UnbilledEntry {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  description      String
  expectedDate     DateTime
  expectedAmount   Float
  status           String    @default("PENDING") // PENDING | DONE
  entryDoneDate    DateTime?
  isRecurring      Boolean   @default(false)
  recurringGroupId String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  @@index([expectedDate])
  @@index([recurringGroupId])
  @@index([companyId])
}

// System-wide, action-level activity feed (admin-only view) — separate from TaskHistory, which
// is a per-task field-level diff. Actor fields are denormalized (not a User relation) so a login
// attempt with a bad email, or a user later deactivated, still reads back sensibly.
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  userName   String
  userRole   String? // ADMIN | EMPLOYEE | null for a failed login before we know who it was
  action     String // LOGIN | LOGIN_FAILED | LOGOUT | CREATE | UPDATE | DELETE
  entityType String // AUTH | TASK | EXPENSE | UNBILLED_ENTRY | EMPLOYEE | COMPANY | DEPARTMENT | CATEGORY
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entityType])
}

// Single shared, cross-company chat channel — every message is visible to every admin/employee.
// mentionedUserIds is populated by the composer UI from an explicit @mention picker (not parsed
// out of free text afterward), so there's no name-collision ambiguity.
model ChatMessage {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId         String   @db.ObjectId
  senderName       String
  senderRole       String // ADMIN | EMPLOYEE
  body             String
  mentionedUserIds String[] @db.ObjectId
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([mentionedUserIds])
}

// One row per user — tracks when they last viewed the chat panel, so we can tell whether a
// message that @mentions them is unread (see getUnreadMentionInfo in chat-service.ts).
model ChatRead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  lastReadAt DateTime @default(now())
}

// Same single-timestamp-marker shape as ChatRead, but for the notification bell's task-assignment
// items — kept as its own model since it's an independent "unread" from chat mentions (see
// getNotifications in notification-service.ts).
model TaskAssignmentRead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  lastReadAt DateTime @default(now())
}
